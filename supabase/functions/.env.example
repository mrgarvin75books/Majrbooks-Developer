# Edge-function secrets for transactional email (Resend).
#
# Production: Supabase dashboard -> Edge Functions -> Secrets (or
#   supabase secrets set NAME=value). Local: copy to supabase/functions/.env
#   and run `supabase functions serve --env-file supabase/functions/.env`.
# Never put any of these in a VITE_ variable: those are shipped to browsers.

# Required. Resend API key with "Sending access" (starts with re_).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Required in production. Public URL of the web app; every link in every email
# is built from it (https only).
APP_URL=https://majrbooks.com

# Optional. Sender on a domain verified in Resend, and where replies go.
EMAIL_FROM="MAJR Books <support@majrbooks.com>"
EMAIL_REPLY_TO=support@prm3tax.com

# Optional. Shown in every email footer and support line.
SUPPORT_EMAIL=support@prm3tax.com
SUPPORT_PHONE=888-575-4776
COMPANY_LEGAL_NAME="PRM3 Tax"
COMPANY_ADDRESS="8108 Cliffdale Rd Suite 104, Fayetteville, NC 28314"

# Optional. Header logo (defaults to $APP_URL/majr-books-logo-email-header.png).
# EMAIL_LOGO_URL=https://majrbooks.com/majr-books-logo-email-header.png

# Optional. Password reset link lifetime in minutes (clamped to 15-60).
PASSWORD_RESET_TTL_MINUTES=60
